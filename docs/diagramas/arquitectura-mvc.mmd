        login["LoginServlet: POST /login"]
        inicio["InicioServlet: GET /inicio"]
    end
    subgraph modelo["MODELO"]
        servicio["AutenticacionService"]
        dao["UsuarioDAO: PreparedStatement"]
        conexion["ConexionBD: conexión JDBC"]
        bean["JavaBean Usuario"]
        servicio -->|consulta| dao
        dao --> conexion
        dao -. devuelve .-> bean
        bean -. datos .-> servicio
    end
    subgraph vista["VISTA: JSP + JSTL"]
        acceso["login.jsp: formulario y mensajes"]
        panel["inicio.jsp: página protegida"]
    end
    mysql[("MySQL: rentatroka")]
    navegador -->|"1. Petición HTTP"| filtros
    filtros -->|"2. POST /login"| login
